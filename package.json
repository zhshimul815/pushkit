{
  "name": "pushkit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-cookie.js",
    "dev": "next dev",
    "build": "node scripts/patch-cookie.js && next build",
    "build:sdk": "esbuild sdk/sdk.js --minify --outfile=public/sdk.js",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "upload:cf": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "db:migrate:local": "wrangler d1 migrations apply pushkit-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pushkit-db --remote",
    "test:webpush": "tsx tests/webpush.roundtrip.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "minimatch": ">=11.0.1"
  },
  "description": "PushKit — free, open-source, self-hosted web push notification platform for the Cloudflare Free Tier.",
  "license": "ELv2"
}
